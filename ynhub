-- Estados
local ESP_ENABLED = false
local AIMBOT_ENABLED = false
local FOV = 120

-- Services
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Camera = workspace.CurrentCamera
local LocalPlayer = Players.LocalPlayer

-- Funções ESP
local function ensureESP(char)
    if not char or not char:IsDescendantOf(workspace) then return end
    if not char:FindFirstChild("HumanoidRootPart") then return end
    if not char:FindFirstChild("YN_ESP_BOX") then
        local box = Instance.new("BoxHandleAdornment")
        box.Name = "YN_ESP_BOX"
        box.Adornee = char
        box.Size = Vector3.new(4, 6, 2)
        box.Color3 = Color3.fromRGB(115,95,255)
        box.Transparency = 0.55
        box.AlwaysOnTop = true
        box.ZIndex = 0
        box.Parent = char
    end
end

local function clearESP(char)
    local b = char and char:FindFirstChild("YN_ESP_BOX")
    if b then b:Destroy() end
end

-- Funções Aimbot
local function getClosestTarget()
    local closestPart, closestDist = nil, math.huge
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            local char = plr.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            local hum = char and char:FindFirstChild("Humanoid")
            if hrp and hum and hum.Health > 0 then
                local pos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
                if onScreen then
                    local dist = (Vector2.new(pos.X, pos.Y) - Camera.ViewportSize/2).Magnitude
                    local sameTeam = (plr.Team ~= nil and LocalPlayer.Team ~= nil and plr.Team == LocalPlayer.Team)
                    if not sameTeam and dist < FOV and dist < closestDist then
                        closestDist, closestPart = dist, hrp
                    end
                end
            end
        end
    end
    return closestPart
end

local function aimAt(target)
    local cam = Camera.CFrame
    local look = (target.Position - cam.Position).Unit
    local desired = CFrame.new(cam.Position, cam.Position + look)
    Camera.CFrame = cam:Lerp(desired, 0.35)
end

-- Loop principal
RunService.RenderStepped:Connect(function()
    -- ESP
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            local char = plr.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            local hum = char and char:FindFirstChild("Humanoid")
            if char and hrp and hum then
                local sameTeam = (plr.Team ~= nil and LocalPlayer.Team ~= nil and plr.Team == LocalPlayer.Team)
                if ESP_ENABLED and hum.Health > 0 and not sameTeam then
                    ensureESP(char)
                else
                    clearESP(char)
                end
            elseif char then
                clearESP(char)
            end
        end
    end

    -- AIMBOT
    if AIMBOT_ENABLED then
        local t = getClosestTarget()
        if t then aimAt(t) end
    end
end)

