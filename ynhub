-- Hover animation nos botões (Size + TextSize)
local normalSize = UDim2.new(1, -20, 0, 32)
local hoverSize = UDim2.new(1, -20, 0, 36)
local normalTextSize = 16
local hoverTextSize = 18
local tweenInfo = TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

local function wireHover(btn)
    btn.MouseEnter:Connect(function()
        TweenService:Create(btn, tweenInfo, {Size = hoverSize}):Play()
        TweenService:Create(btn, tweenInfo, {TextSize = hoverTextSize}):Play()
        btn.BackgroundColor3 = Color3.fromRGB(28,28,32)
    end)
    btn.MouseLeave:Connect(function()
        TweenService:Create(btn, tweenInfo, {Size = normalSize}):Play()
        TweenService:Create(btn, tweenInfo, {TextSize = normalTextSize}):Play()
        btn.BackgroundColor3 = BG_COLOR
    end)
end

for _, b in ipairs({BTN_HOME, BTN_ESP, BTN_AIMBOT, ToggleESP, ToggleAIM}) do
    wireHover(b)
end

-- ESP: BoxHandleAdornment por personagem (funciona sem Drawing API)
local function ensureESP(char)
    if not char or not char:IsDescendantOf(workspace) then return end
    if not char:FindFirstChild("HumanoidRootPart") then return end
    if not char:FindFirstChild("YN_ESP_BOX") then
        local box = Instance.new("BoxHandleAdornment")
        box.Name = "YN_ESP_BOX"
        box.Adornee = char
        box.Size = Vector3.new(4, 6, 2)
        box.Color3 = ACCENT
        box.Transparency = 0.55
        box.AlwaysOnTop = true
        box.ZIndex = 0
        box.Parent = char
    end
end

local function clearESP(char)
    local b = char and char:FindFirstChild("YN_ESP_BOX")
    if b then b:Destroy() end
end

-- Aimbot target
local function getClosestTarget()
    local closestPart, closestDist = nil, math.huge
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            local char = plr.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            local hum = char and char:FindFirstChild("Humanoid")
            if hrp and hum and hum.Health > 0 then
                local pos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
                if onScreen then
                    local dist = (Vector2.new(pos.X, pos.Y) - Camera.ViewportSize / 2).Magnitude
                    -- Filtro básico de time; ajuste conforme seu jogo
                    local sameTeam = (plr.Team ~= nil and LocalPlayer.Team ~= nil and plr.Team == LocalPlayer.Team)
                    if not sameTeam and dist < FOV and dist < closestDist then
                        closestDist, closestPart = dist, hrp
                    end
                end
            end
        end
    end
    return closestPart
end

local function aimAt(target)
    local cam = Camera.CFrame
    local look = (target.Position - cam.Position).Unit
    local desired = CFrame.new(cam.Position, cam.Position + look)
    Camera.CFrame = cam:Lerp(desired, 0.35)
end

-- Loop principal
RunService.RenderStepped:Connect(function()
    -- ESP
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            local char = plr.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            local hum = char and char:FindFirstChild("Humanoid")
            if char and hrp and hum then
                local sameTeam = (plr.Team ~= nil and LocalPlayer.Team ~= nil and plr.Team == LocalPlayer.Team)
                if ESP_ENABLED and hum.Health > 0 and not sameTeam then
                    ensureESP(char)
                else
                    clearESP(char)
                end
            elseif char then
                clearESP(char)
            end
        end
    end

    -- AIMBOT
    if AIMBOT_ENABLED then
        local t = getClosestTarget()
        if t then aimAt(t) end
    end
end)

